# Copy this file to .env and fill at least one key. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider answers first, and fallbacks on rate limits / outages
LLM_PROVIDER=groq
LLM_FALLBACKS=gemini,groq,openrouter
# Optional overrides of the preset model names
# LLM_MODEL=
# LLM_FAST_MODEL=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash

# Plug in ANY OpenAI-compatible endpoint (e.g. a key the interview panel provides):
# LLM_PROVIDER=custom
# CUSTOM_BASE_URL=https://example.com/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
